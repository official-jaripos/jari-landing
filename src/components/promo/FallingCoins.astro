---
// src/components/promo/FallingCoins.astro
import { promoSeptemberCuan } from '../../data/promo';

const isActive = promoSeptemberCuan.isActive;
---

{isActive && (
  <div id="coin-container" class="fixed inset-0 pointer-events-none z-[40] overflow-hidden" aria-hidden="true"></div>
  <style>
    @keyframes coin-fall {
      0% {
        transform: translateY(-12vh);
        opacity: 0;
      }
      8% {
        opacity: 0.95;
      }
      88% {
        opacity: 0.95;
      }
      100% {
        transform: translateY(112vh);
        opacity: 0;
      }
    }

    @keyframes coin-tumble {
      0% {
        transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg) translateX(-20px);
      }
      50% {
        transform: rotateX(180deg) rotateY(180deg) rotateZ(180deg) translateX(20px);
      }
      100% {
        transform: rotateX(360deg) rotateY(360deg) rotateZ(360deg) translateX(-20px);
      }
    }
    
    .coin-wrapper {
      position: absolute;
      top: -12vh;
      animation: coin-fall linear forwards;
      will-change: transform, opacity;
    }

    .coin-particle {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #fffbeb 0%, #fbbf24 35%, #d97706 75%, #92400e 100%);
      box-shadow: 
        inset 0 0 0 1.5px rgba(255, 255, 255, 0.65),
        inset 0 0 0 3px rgba(180, 83, 9, 0.4),
        0 4px 10px rgba(0, 0, 0, 0.18),
        0 1px 3px rgba(0, 0, 0, 0.12);
      animation: coin-tumble ease-in-out infinite;
      will-change: transform;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #78350f;
      font-weight: 900;
      font-size: 8px;
      line-height: 1;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      user-select: none;
      text-shadow: 0 1px 0 rgba(255, 255, 255, 0.4);
    }
  </style>

  <script>
    function createCoin() {
      const container = document.getElementById('coin-container');
      if (!container) return;
      
      const wrapper = document.createElement('div');
      wrapper.classList.add('coin-wrapper');
      
      const coin = document.createElement('div');
      coin.classList.add('coin-particle');
      coin.textContent = 'Rp';
      
      // Randomize position, falling speed, and tumbling speed
      const leftPos = Math.random() * 100;
      const fallDuration = Math.random() * 4 + 6; // 6-10 seconds to fall gently
      const tumbleDuration = Math.random() * 2 + 1.8; // 1.8-3.8 seconds per tumble
      const delay = Math.random() * 2;
      
      // Randomize scale for depth effect (some appear in background, some in foreground)
      const scale = Math.random() * 0.5 + 0.55; // 0.55x to 1.05x size
      coin.style.transform = `scale(${scale})`;
      
      wrapper.style.left = `${leftPos}vw`;
      wrapper.style.animationDuration = `${fallDuration}s`;
      wrapper.style.animationDelay = `${delay}s`;
      
      coin.style.animationDuration = `${tumbleDuration}s`;
      
      wrapper.appendChild(coin);
      container.appendChild(wrapper);
      
      // Clean up element after it finishes falling to prevent memory leak
      setTimeout(() => {
        wrapper.remove();
      }, (fallDuration + delay) * 1000);
    }
    
    // Maintain a max of 35 coins for an elegant, non-cluttered ambient effect
    const maxCoins = 35;
    const coinInterval = setInterval(() => {
      const currentCoins = document.querySelectorAll('.coin-wrapper').length;
      if (currentCoins < maxCoins) {
        createCoin();
      }
    }, 280);
  </script>
)}
