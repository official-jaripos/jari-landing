---
import '../styles/index.css';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
    title="Daftar Harga & Paket Rencana Jaripos | Aplikasi Kasir Pintar"
    description="Temukan paket harga Jaripos yang sesuai untuk bisnis Anda. Dari Paket Kelingking gratis selamanya hingga Paket Jempol premium yang murah dengan fitur AI terlengkap."
    keywords="harga aplikasi kasir, kasir pintar murah, pos gratis, aplikasi kasir umkm, paket langganan jaripos, pos murah indonesia"
>
    <Navbar />

    <main class="relative z-10 bg-white text-slate-600 pt-32">
        <!-- Hero & Header Wrapper with Light Geometric Mesh -->
        <div class="hero-light-wrapper border-b border-slate-100">
            <div class="mesh-grid-light"></div>
            <!-- Hero Section -->
            <section class="py-20 relative overflow-hidden">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
                    <h1 class="text-4xl md:text-6xl font-black tracking-tight text-[#121417] mb-6">
                        Investasi Minimal, <br/>
                        <span class="text-[#1f5aa2]">Hasil Maksimal</span>
                    </h1>
                    <p class="text-slate-600 text-lg md:text-xl max-w-3xl mx-auto mb-10 leading-relaxed">
                        Kami percaya setiap bisnis UMKM berhak atas alat kasir digital yang canggih tanpa perlu mengeluarkan biaya jutaan rupiah. Pilih paket yang sesuai dengan skala bisnis Anda.
                    </p>
                </div>
            </section>
        </div>

        <!-- Pricing Cards Section -->
        <section class="py-12 bg-slate-50 border-y border-slate-100">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="max-w-5xl mx-auto">
                    <!-- Focused Premium Plan Card -->
                    <div class="bg-white border-2 border-[#1f5aa2] rounded-[2.5rem] p-8 md:p-12 flex flex-col md:flex-row gap-10 md:gap-16 shadow-2xl relative overflow-hidden group items-center">
                        <div class="absolute top-0 right-8 bg-[#1f5aa2] text-white text-xs font-black uppercase tracking-widest px-6 py-2 rounded-b-xl shadow-md z-20">REKOMENDASI</div>
                        
                        <!-- Info Kiri -->
                        <div class="flex-1 w-full relative z-10">
                            <span class="px-4 py-1.5 rounded-full bg-[#1f5aa2]/10 text-[#1f5aa2] text-xs font-bold uppercase tracking-wider inline-block mb-6">Uji Coba 14 Hari</span>
                            <h2 class="text-3xl md:text-4xl font-black text-slate-900 mb-4">Paket Jempol</h2>
                            <p class="text-slate-600 text-base mb-8 leading-relaxed">Akses lengkap ke seluruh ekosistem kasir pintar Jaripos yang didukung penuh oleh otomasi laporan harian dan asisten AI.</p>
                            
                            <div class="flex flex-col mb-8 bg-[#1f5aa2]/5 p-6 rounded-2xl border border-[#1f5aa2]/20 space-y-4">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-bold text-slate-600 uppercase tracking-wider">Paket 1 Tahun</span>
                                    <span class="px-3 py-1.5 rounded-full bg-gradient-to-r from-[#1f5aa2] to-blue-500 text-white font-black text-[11px] uppercase shadow-lg shadow-[#1f5aa2]/30 flex items-center gap-1.5 transform scale-105">
                                        <svg class="w-3.5 h-3.5 text-yellow-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path></svg>
                                        HEMAT 38%
                                    </span>
                                </div>
                                
                                <div>
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-sm font-semibold text-slate-500">Harga Normal:</span>
                                        <span class="text-lg md:text-xl font-bold text-slate-400 line-through decoration-red-500 decoration-2">Rp 65.000</span>
                                    </div>
                                    <div class="flex items-baseline gap-2">
                                        <span class="text-5xl md:text-7xl font-black text-slate-900 tracking-tight">Rp 34k</span>
                                        <span class="text-slate-600 text-lg font-bold">/ Bulan</span>
                                    </div>
                                </div>

                                <div class="flex justify-center pt-4 border-t border-[#1f5aa2]/20">
                                    <span class="inline-flex items-center gap-2 text-sm font-bold text-[#1f5aa2] bg-[#1f5aa2]/10 px-4 py-1.5 rounded-full">
                                        💡 Investasi pintar, cuma seribuan sehari!
                                    </span>
                                </div>
                            </div>

                            <a href="https://app.jaripos.com/register" class="hidden md:block w-full text-center py-5 bg-[#1f5aa2] hover:bg-[#164075] active:scale-95 font-bold rounded-2xl transition-all duration-300 ease-out shadow-lg shadow-[#1f5aa2]/30 text-white text-base">
                                Mulai Coba Gratis 14 Hari
                            </a>
                        </div>

                        <!-- Fitur Kanan -->
                        <div class="flex-1 w-full bg-slate-50 p-8 rounded-3xl border border-slate-100 relative z-10">
                            <h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                                <svg class="w-5 h-5 text-[#1f5aa2]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Apa yang Anda Dapatkan?
                            </h3>
                            <ul class="space-y-5 text-sm text-slate-700">
                                <li class="flex items-start gap-3">
                                    <span class="text-[#1f5aa2] mt-0.5">✓</span> 
                                    <span class="font-medium text-slate-900">Maksimal 1.000 Transaksi Penjualan / Hari</span>
                                </li>
                                <li class="flex items-start gap-3">
                                    <span class="text-[#1f5aa2] mt-0.5">✓</span> 
                                    <span class="font-medium text-slate-900">Maksimal 500 Produk (1.000 Varian)</span>
                                </li>
                                <li class="flex items-start gap-3">
                                    <span class="text-[#1f5aa2] mt-0.5">✓</span> 
                                    <span>Owner + Maksimal 5 Akun Staf (Hak Akses)</span>
                                </li>
                                <li class="flex items-start gap-3">
                                    <span class="text-[#1f5aa2] mt-0.5">✓</span> 
                                    <span class="font-bold text-[#1f5aa2]">Laporan Laba/Rugi Lengkap Otomatis</span>
                                </li>
                                <li class="flex items-start gap-3">
                                    <span class="text-[#1f5aa2] mt-0.5">✓</span> 
                                    <span>Cetak Struk Bluetooth & Laporan Laba/Rugi Lengkap</span>
                                </li>
                                <li class="flex items-start gap-3">
                                    <span class="text-[#1f5aa2] mt-0.5">✓</span> 
                                    <span>Prioritas Dukungan WhatsApp 24/7</span>
                                </li>
                                <li class="flex items-start gap-3">
                                    <span class="text-[#1f5aa2] mt-0.5">✓</span> 
                                    <span class="font-bold text-slate-900">Jari AI (Asisten Pintar Pribadi) & Rekomendasi Stok Pintar</span>
                                </li>
                            </ul>
                            
                            <!-- Mobile Button -->
                            <a href="https://app.jaripos.com/register" class="md:hidden mt-8 block w-full text-center py-4 bg-[#1f5aa2] hover:bg-[#164075] active:scale-95 font-bold rounded-2xl transition-all duration-300 ease-out shadow-lg shadow-[#1f5aa2]/30 text-white text-base">
                                Mulai Coba Gratis 14 Hari
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Feature Comparison Matrix -->
        <section class="py-24 bg-white border-t border-slate-100">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-extrabold text-slate-900">Perbandingan Detail</h2>
                    <p class="text-slate-500 mt-2">Bandingkan fitur secara rinci sebelum menentukan pilihan.</p>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-lg shadow-slate-100/50">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-slate-200 bg-slate-50">
                                <th class="p-6 text-sm font-bold text-slate-800">Fitur Utama</th>
                                <th class="p-6 text-sm font-bold text-slate-800">Paket Kelingking</th>
                                <th class="p-6 text-sm font-bold text-[#1f5aa2]">Paket Jempol</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-sm">
                            <tr>
                                <td class="p-6 font-semibold text-slate-900">Batas Transaksi Penjualan</td>
                                <td class="p-6 text-slate-600">Maksimal 50 transaksi / hari</td>
                                <td class="p-6 text-[#1f5aa2] font-semibold">Maksimal 1.000 transaksi / hari</td>
                            </tr>
                            <tr>
                                <td class="p-6 font-semibold text-slate-900">Kapasitas Produk & Varian</td>
                                <td class="p-6 text-slate-600">10 Produk (Max 25 Varian)</td>
                                <td class="p-6 text-[#1f5aa2] font-semibold">500 Produk (Max 1.000 Varian)</td>
                            </tr>
                            <tr>
                                <td class="p-6 font-semibold text-slate-900">Kategori & Supplier</td>
                                <td class="p-6 text-slate-600">Max 5 Kategori / 5 Supplier</td>
                                <td class="p-6 text-[#1f5aa2] font-semibold">Max 50 Kategori / 100 Supplier</td>
                            </tr>
                            <tr>
                                <td class="p-6 font-semibold text-slate-900">Akun Kasir (Staff)</td>
                                <td class="p-6 text-slate-600">Owner saja (0 akun staf)</td>
                                <td class="p-6 text-[#1f5aa2] font-semibold">Owner + Max 5 akun staf (Role Akses)</td>
                            </tr>
                            <tr>
                                <td class="p-6 font-semibold text-slate-900">Jari AI (Asisten Pribadi))</td>
                                <td class="p-6 text-slate-400">✗ Tidak tersedia</td>
                                <td class="p-6 text-[#1f5aa2] font-bold">✓ Tersedia (Akses Penuh)</td>
                            </tr>
                            <tr>
                                <td class="p-6 font-semibold text-slate-900">Rekomendasi Stok Pintar</td>
                                <td class="p-6 text-slate-400">✗ Tidak tersedia</td>
                                <td class="p-6 text-[#1f5aa2] font-bold">✓ Tersedia (Akses Penuh)</td>
                            </tr>
                            <tr>
                                <td class="p-6 font-semibold text-slate-900">Cetak Struk</td>
                                <td class="p-6 text-slate-600">✓ Tersedia (Max 5 Metode Bayar)</td>
                                <td class="p-6 text-[#1f5aa2] font-semibold">✓ Tersedia (Max 50 Metode Bayar)</td>
                            </tr>
                            <tr>
                                <td class="p-6 font-semibold text-slate-900">Laporan Keuangan</td>
                                <td class="p-6 text-slate-600">Harian Sederhana</td>
                                <td class="p-6 text-[#1f5aa2] font-semibold">Laba/Rugi lengkap & Analytics Real-Time</td>
                            </tr>
                            <tr>
                                <td class="p-6 font-semibold text-slate-900">Stock Opname</td>
                                <td class="p-6 text-slate-600">Maksimal 10 kali / bulan</td>
                                <td class="p-6 text-[#1f5aa2] font-semibold">Maksimal 1.000 kali / bulan</td>
                            </tr>
                            <tr>
                                <td class="p-6 font-semibold text-slate-900">Promosi (Voucher Diskon)</td>
                                <td class="p-6 text-slate-400">✗ Tidak tersedia</td>
                                <td class="p-6 text-[#1f5aa2] font-semibold">Maksimal 100 Voucher</td>
                            </tr>
                            <tr>
                                <td class="p-6 font-semibold text-slate-900">Dukungan (Support)</td>
                                <td class="p-6 text-slate-400">✗ Tidak tersedia</td>
                                <td class="p-6 text-[#1f5aa2] font-semibold">Prioritas Chat WhatsApp Grup</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Pricing FAQ Section -->
        <section class="py-20 bg-slate-50 border-t border-slate-100">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-3xl font-extrabold text-slate-900">Pertanyaan Seputar Harga (FAQ)</h2>
                    <p class="text-slate-500 mt-2">Masih ragu? Temukan jawaban atas pertanyaan umum berikut.</p>
                </div>

                <div class="space-y-6">
                    <div class="p-6 bg-white rounded-2xl border border-slate-100 shadow-sm">
                        <h4 class="font-bold text-slate-900 text-base mb-2">Apakah benar Paket Kelingking gratis selamanya?</h4>
                        <p class="text-slate-600 text-sm leading-relaxed">Ya, Paket Kelingking 100% gratis selamanya tanpa membutuhkan kartu kredit saat pendaftaran. Sangat cocok untuk usaha mikro atau usaha pemula.</p>
                    </div>
                    <div class="p-6 bg-white rounded-2xl border border-slate-100 shadow-sm">
                        <h4 class="font-bold text-slate-900 text-base mb-2">Bagaimana jika masa uji coba Paket Jempol (14 hari) berakhir?</h4>
                        <p class="text-slate-600 text-sm leading-relaxed">Setelah 14 hari uji coba berakhir, jika Anda belum berlangganan, akun akan otomatis beralih ke Paket Kelingking. Data Anda yang melebihi batas (seperti produk ke-11 ke atas) tidak akan dihapus, melainkan dibekukan sementara hingga Anda melakukan upgrade kembali.</p>
                    </div>

                    <div class="p-6 bg-white rounded-2xl border border-slate-100 shadow-sm">
                        <h4 class="font-bold text-slate-900 text-base mb-2">Bagaimana metode pembayaran langganannya?</h4>
                        <p class="text-slate-600 text-sm leading-relaxed">Anda dapat melakukan pembayaran langganan melalui transfer bank, dompet digital (Gopay, OVO, Dana, LinkAja), maupun QRIS secara instan dari aplikasi.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-24 bg-gradient-to-b from-slate-50 to-white border-t border-slate-100 text-center relative overflow-hidden">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <h2 class="text-3xl md:text-5xl font-black text-slate-900 mb-6">Mulai Transformasi Bisnis Anda</h2>
                <p class="text-slate-600 text-md md:text-lg mb-8 max-w-2xl mx-auto leading-relaxed">
                    Daftar sekarang dan nikmati seluruh kemudahan operasional kasir dalam satu genggaman HP.
                </p>
                <div class="flex justify-center gap-4">
                    <a href="https://app.jaripos.com/register" class="group inline-flex items-center justify-center rounded-full px-8 py-4 font-bold text-white bg-[#1f5aa2] hover:bg-[#164075] active:scale-95 transition-colors duration-300 ease-out shadow-lg shadow-[#1f5aa2]/20 gap-2">
                        <span>Coba Gratis 14 Hari</span>
                        <svg class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
